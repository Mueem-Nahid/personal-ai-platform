# pyproject.toml manages deps; empty .env to seed values

APP_DEBUG=true
APP_DATABASE_URL=postgresql+asyncpg://agent:agent_secret@localhost:5432/career_agent
APP_REDIS_URL=redis://localhost:6379/0
APP_QDRANT_URL=http://localhost:6333
APP_OLLAMA_URL=http://localhost:11434
APP_OLLAMA_MODEL=qwen3:8b
APP_OLLAMA_EMBED_MODEL=bge-m3
APP_LLM_PROVIDER=groq
APP_LLM_MODEL=openai/gpt-oss-120b
APP_LLM_TIMEOUT_SECONDS=30
APP_LLM_TEMPERATURE=0.1
APP_LLM_MAX_TOKENS=1024
APP_LLM_MAX_TEXT_CHARS=6000
APP_GROQ_API_KEY=""
APP_MINIO_ENDPOINT=localhost:9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
APP_PROMPTS_PATH=../prompts

